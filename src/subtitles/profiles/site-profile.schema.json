{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://norixor.org/schemas/norixortrans-site-profile-v1.json",
  "title": "nTrans subtitle site profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "name",
    "parser",
    "priority",
    "match",
    "selectors",
    "capture"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "version": { "const": 1 },
    "name": { "type": "string", "minLength": 1, "maxLength": 100 },
    "parser": { "enum": ["html5", "youtube", "netflix", "dom"] },
    "priority": { "type": "integer", "minimum": 0, "maximum": 1000 },
    "match": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hostnameSuffixes"],
      "properties": {
        "hostnameSuffixes": {
          "type": "array",
          "items": { "type": "string" },
          "maxItems": 32
        },
        "urlRules": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["hostnameSuffixes", "pathnamePrefixes"],
            "properties": {
              "hostnameSuffixes": {
                "type": "array",
                "minItems": 1,
                "maxItems": 32,
                "items": { "type": "string" }
              },
              "pathnamePrefixes": {
                "type": "array",
                "minItems": 1,
                "maxItems": 32,
                "items": { "type": "string", "pattern": "^/" }
              }
            }
          }
        }
      }
    },
    "selectors": {
      "type": "object",
      "additionalProperties": false,
      "required": ["video", "captions", "nativeCaptions"],
      "properties": {
        "video": { "type": "string", "minLength": 1, "maxLength": 500 },
        "captions": {
          "type": "array",
          "items": { "type": "string", "maxLength": 500 },
          "maxItems": 32
        },
        "nativeCaptions": {
          "type": "array",
          "items": { "type": "string", "maxLength": 500 },
          "maxItems": 32
        }
      }
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formats", "allowedHostnameSuffixes", "urlPatterns"],
      "properties": {
        "formats": {
          "type": "array",
          "items": { "enum": ["vtt", "ttml", "json3"] },
          "maxItems": 8
        },
        "allowedHostnameSuffixes": {
          "type": "array",
          "items": { "type": "string" },
          "maxItems": 32
        },
        "urlPatterns": {
          "type": "array",
          "items": { "type": "string", "maxLength": 500 },
          "maxItems": 32
        },
        "completeFilePatterns": {
          "type": "array",
          "items": { "type": "string", "maxLength": 500 },
          "maxItems": 32
        }
      }
    }
  }
}
